from pydantic import BaseModel


class SignupRequest(BaseModel):

    fullName: str
    email: str
    password: str
    confirmPassword: str


class LoginRequest(BaseModel):

    email: str
    password: str


class LoginResponse(BaseModel):

    access_token: str
    token_type: str


class SignupResponse(BaseModel):

    message: str
    user_id: int